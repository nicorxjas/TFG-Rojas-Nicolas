# Supabase: mismo proyecto que el frontend. Reemplazar los placeholders.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_POR_SERVICE_ROLE_PRIVADA
SUPABASE_JWT_SECRET=REEMPLAZAR_POR_SECRETO_JWT_HS256

# Demo TFG: Codex CLI con sesion iniciada y acceso al modelo configurado.
LLM_PROVIDER=codex
LLM_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=120
# Opcional: ruta completa a codex.exe si no se detecta automaticamente.
CODEX_EXECUTABLE=

# Cube local: CUBEJS_DEV_MODE=true en cube/.env.
CUBE_API_URL=http://localhost:4000/cubejs-api/v1/load
# Opcional en desarrollo. No usar un secreto de firma como JWT de produccion.
CUBEJS_API_SECRET=

# Informes: vacios heredan el modelo y limites del codigo.
REPORT_LLM_MODEL=
REPORT_LLM_TIMEOUT_SECONDS=
REPORT_LLM_MAX_TOKENS=
REPORT_LLM_MAX_RETRIES=5
SEMANTIC_CATALOG_CACHE_TTL_SECONDS=30

# Vacio desactiva trazas. Si se habilitan, usar backend/runtime/bi-traces.
BI_TRACE_DIR=

# Opcional: scripts auxiliares de conexion directa a PostgreSQL.
DATABASE_URL=

# Power BI / Microsoft Entra: opcional para Excel.
POWERBI_TENANT_ID=common
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_REDIRECT_URI=http://localhost:8000/connectors/powerbi/callback
# Vacio usa SUPABASE_SERVICE_ROLE_KEY como fallback server-side.
POWERBI_OAUTH_STATE_SECRET=
# Opcional: clave Fernet; requiere cryptography para usar ese esquema.
# Mantener estable para descifrar los tokens guardados.
POWERBI_TOKEN_ENCRYPTION_KEY=
API_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
POWERBI_SCAN_TIMEOUT_SECONDS=45
